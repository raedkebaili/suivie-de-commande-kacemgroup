# =============================================================================
# OrderTrack Pro — Configuration
# =============================================================================
# Ce fichier est copié automatiquement en .env par setup.bat lors de la
# première installation. Modifiez .env (pas ce fichier) pour personnaliser.
# =============================================================================

# ── Base de données PostgreSQL ──
# Format : postgresql://utilisateur:motdepasse@hôte:port/nom_base
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/otp_db

# ── Sécurité ──
# Clé secrète pour signer les tokens JWT d'authentification.
# IMPORTANT : remplacez par une chaîne aléatoire d'au moins 32 caractères.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# ── Réseau ──
# URL publique de l'application (utilisée pour les liens absolus)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de données avancé ──
# Nombre maximum de connexions simultanées au pool PostgreSQL (défaut : 20)
# DB_POOL_MAX=20
