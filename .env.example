# =============================================================================
# OrderTrack Pro — Configuration
# =============================================================================
# Ce fichier est copié automatiquement en .env par setup.bat lors de la
# première installation. Modifiez .env (pas ce fichier) pour personnaliser.
# =============================================================================

# ── Base de données PostgreSQL ──
# Valeur fournie par l’administrateur système dans l’environnement hors dépôt.
DATABASE_URL=replace-with-database-url

# ── Sécurité (CORRECTIFS — toutes les clés sont OBLIGATOIRES en prod) ──
# Clé secrète pour signer les tokens JWT d'authentification. OBLIGATOIRE :
# l'application refuse de signer/vérifier sans elle (aucun repli codé en dur).
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# Mot de passe du premier compte admin créé uniquement dans une base vide.
# Remplacez cette valeur par un mot de passe unique avant le premier démarrage.
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-initial-password-2026

# Clé de chiffrement AES-256-GCM des secrets au repos (Google Drive).
# 64 caractères hexadécimaux (32 octets).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=change-this-to-64-hexadecimal-chars-from-randombytes32

# Secret partagé des sauvegardes automatiques (planificateur serveur intégré
# et cron externe éventuel : en-tête x-backup-secret).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_SECRET=change-this-to-a-random-hex-string

# ── Réseau ──
# URL publique de l'application (utilisée pour les liens absolus)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de données avancé ──
# Nombre maximum de connexions simultanées au pool PostgreSQL (défaut : 20)
# DB_POOL_MAX=20
